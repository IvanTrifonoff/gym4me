{
  "version": 1,
  "owner": "athlete",
  "storage": "legacy-compatible per-athlete state repository",
  "settings": ["unit", "restSec", "sound", "keepAwake", "lang", "theme", "accent", "body", "targetW", "gifSize", "effort", "reminder"],
  "training": ["bodyweight", "routines", "week", "dayPlan", "exWeights", "workouts", "active"],
  "content": ["customEx"],
  "rules": [
    "state is physically separated by athlete id",
    "unknown fields are discarded",
    "writes use a temporary file and atomic rename",
    "production data directory is configured at runtime and is never committed"
  ]
}
